// This is the Prisma schema file specifically and exclusively for Products

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Product {
    id          Int      @id @default(autoincrement())
    title       String
    details     String
    price       Float
    images      String
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    createdById String

    @@index([title])
}
